<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="315"
                android:startColor="#3338BDF8"
                android:centerColor="#1CFFFFFF"
                android:endColor="#29818CF8"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
