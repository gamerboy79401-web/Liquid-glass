<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF060914"
                android:centerColor="#FF0E172E"
                android:endColor="#FF13112C"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top-left cyan liquid orb -->
    <item
        android:top="-120dp"
        android:left="-80dp"
        android:right="140dp"
        android:bottom="420dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#3338BDF8"
                android:endColor="#0038BDF8" />
        </shape>
    </item>
    <!-- Bottom-right indigo-violet liquid orb -->
    <item
        android:top="340dp"
        android:left="120dp"
        android:right="-100dp"
        android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:startColor="#2E818CF8"
                android:endColor="#00818CF8" />
        </shape>
    </item>
</layer-list>
